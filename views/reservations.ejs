<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Request a Reservation | Court Booking</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script type="module" src="/app.js"></script>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900">
    <%- include("partials/header") %>

    <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <section
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]"
        aria-labelledby="reservation-heading"
      >
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
          <p class="text-sm font-bold uppercase tracking-widest text-emerald-700">
            Court request
          </p>

          <h1
            id="reservation-heading"
            class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"
          >
            Request a pickleball court
          </h1>

          <p class="mt-4 max-w-2xl leading-7 text-slate-600">
            Pick a court, time, party size, and skill level. Saved requests
            stay on this page after refresh.
          </p>

          <p
            id="form-message"
            class="mt-4 min-h-6 text-sm font-medium text-emerald-700"
            role="status"
            aria-live="polite"
          >
            <% if (error) { %><%= error %><% } %>
          </p>

          <form
            id="reservation-form"
            class="mt-4 space-y-6"
            action="/reservations"
            method="post"
            novalidate
          >
            <div>
              <label
                for="playerName"
                class="mb-2 block text-sm font-semibold text-slate-700"
              >
                Your name
              </label>

              <input
                id="playerName"
                name="playerName"
                type="text"
                autocomplete="name"
                value="<%= formData.playerName %>"
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
              >

              <p
                class="mt-1 min-h-5 text-sm font-medium text-red-600"
                data-error-for="playerName"
              ><%= errors.playerName || "" %></p>
            </div>

            <div>
              <label
                for="courtName"
                class="mb-2 block text-sm font-semibold text-slate-700"
              >
                Court
              </label>

              <select
                id="courtName"
                name="courtName"
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
              >
                <option value="">Choose a court</option>

                <% ["North Court", "South Court", "Community Center Court"].forEach((court) => { %>
                  <option
                    value="<%= court %>"
                    <%= formData.courtName === court ? "selected" : "" %>
                  ><%= court %></option>
                <% }) %>
              </select>

              <p
                class="mt-1 min-h-5 text-sm font-medium text-red-600"
                data-error-for="courtName"
              ><%= errors.courtName || "" %></p>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label
                  for="reservationDate"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Date
                </label>

                <input
                  id="reservationDate"
                  name="reservationDate"
                  type="date"
                  value="<%= formData.reservationDate %>"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
                >

                <p
                  class="mt-1 min-h-5 text-sm font-medium text-red-600"
                  data-error-for="reservationDate"
                ><%= errors.reservationDate || "" %></p>
              </div>

              <div>
                <label
                  for="reservationTime"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Time
                </label>

                <input
                  id="reservationTime"
                  name="reservationTime"
                  type="time"
                  value="<%= formData.reservationTime %>"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
                >

                <p
                  class="mt-1 min-h-5 text-sm font-medium text-red-600"
                  data-error-for="reservationTime"
                ><%= errors.reservationTime || "" %></p>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label
                  for="partySize"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Party size
                </label>

                <select
                  id="partySize"
                  name="partySize"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
                >
                  <option value="">Choose size</option>

                  <% [1, 2, 3, 4].forEach((size) => { %>
                    <option
                      value="<%= size %>"
                      <%= String(formData.partySize) === String(size) ? "selected" : "" %>
                    ><%= size %></option>
                  <% }) %>
                </select>

                <p
                  class="mt-1 min-h-5 text-sm font-medium text-red-600"
                  data-error-for="partySize"
                ><%= errors.partySize || "" %></p>
              </div>

              <div>
                <label
                  for="skillLevel"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Skill level
                </label>

                <select
                  id="skillLevel"
                  name="skillLevel"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
                >
                  <option value="">Choose level</option>

                  <% [1, 2, 3, 4, 5].forEach((level) => { %>
                    <option
                      value="<%= level %>"
                      <%= String(formData.skillLevel) === String(level) ? "selected" : "" %>
                    ><%= level %></option>
                  <% }) %>
                </select>

                <p
                  class="mt-1 min-h-5 text-sm font-medium text-red-600"
                  data-error-for="skillLevel"
                ><%= errors.skillLevel || "" %></p>
              </div>
            </div>

            <button
              class="w-full rounded-lg bg-emerald-700 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:w-auto"
              type="submit"
            >
              Save reservation request
            </button>
          </form>
        </div>

        <section
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8"
          aria-labelledby="saved-reservations-heading"
        >
          <div class="border-b border-slate-200 pb-5">
            <p class="text-sm font-bold uppercase tracking-widest text-emerald-700">
              Saved requests
            </p>

            <h2
              id="saved-reservations-heading"
              class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
            >
              Current reservations
            </h2>
          </div>

          <ol id="reservation-list" class="mt-6 space-y-4">
            <% if (reservations.length === 0) { %>
              <li
                class="empty-state rounded-xl border-2 border-dashed border-slate-300 px-5 py-10 text-center text-slate-500"
              >
                No reservations saved yet.
              </li>
            <% } %>

            <% reservations.forEach((reservation) => { %>
              <li
                class="reservation-item rounded-xl border border-slate-200 bg-slate-50 p-5 transition hover:border-emerald-300 hover:shadow-sm"
                data-reservation-id="<%= reservation.id %>"
              >
                <div class="flex flex-col gap-1">
                  <strong class="text-lg text-slate-900">
                    <%= reservation.playerName %>
                  </strong>

                  <span class="font-medium text-emerald-700">
                    <%= reservation.courtName %>
                  </span>
                </div>

                <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                  <div class="rounded-lg bg-white p-3">
                    <dt class="font-semibold text-slate-500">Date</dt>
                    <dd class="mt-1 text-slate-900"><%= reservation.reservationDate %></dd>
                  </div>

                  <div class="rounded-lg bg-white p-3">
                    <dt class="font-semibold text-slate-500">Time</dt>
                    <dd class="mt-1 text-slate-900"><%= reservation.reservationTime %></dd>
                  </div>

                  <div class="rounded-lg bg-white p-3">
                    <dt class="font-semibold text-slate-500">Party</dt>
                    <dd class="mt-1 text-slate-900"><%= reservation.partySize %></dd>
                  </div>

                  <div class="rounded-lg bg-white p-3">
                    <dt class="font-semibold text-slate-500">Skill</dt>
                    <dd class="mt-1 text-slate-900"><%= reservation.skillLevel %></dd>
                  </div>
                </dl>

                <% if (currentUser && (currentUser.role === "admin" || currentUser.id === reservation.ownerId)) { %>
                  <button
                    type="button"
                    class="mt-4 w-full rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-700 transition hover:border-red-600 hover:bg-red-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 sm:w-auto"
                    hx-delete="/reservations/<%= reservation.id %>"
                    hx-target="closest li"
                    hx-swap="outerHTML"
                    hx-confirm="Cancel this reservation?"
                  >
                    Cancel
                  </button>
                <% } %>
              </li>
            <% }) %>
          </ol>
        </section>
      </section>
    </main>
  </body>
</html>