<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Player Skill Levels | Court Booking</title>
    <link rel="stylesheet" href="/style.css">
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900">
    <%- include("partials/header") %>

    <main class="mx-auto max-w-2xl px-4 py-10">
      <h1 class="text-3xl font-bold text-slate-900">Player Skill Levels</h1>
      <p class="mt-3 text-slate-600">Players can list a skill level from 1 to 5 so it is easier to find a good match.</p>

      <ul class="mt-4 list-disc pl-5 text-slate-700">
        <li>1-2: New to pickleball</li>
        <li>3: Comfortable with the basics</li>
        <li>4-5: Experienced player</li>
      </ul>

      <p class="mt-6">
        <a class="text-emerald-700 underline hover:text-emerald-800" href="/">Back home</a>
      </p>
    </main>
  </body>
</html>
