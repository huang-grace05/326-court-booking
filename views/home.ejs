<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Court Booking</title>
    <link rel="stylesheet" href="/style.css">
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900">
    <%- include("partials/header") %>

    <main class="mx-auto max-w-2xl px-4 py-10">
      <h1 class="text-3xl font-bold text-slate-900">Court Booking</h1>
      <p class="mt-3 text-slate-600">A simple pickleball court reservation app for our COMPSCI 326 project.</p>
      <p class="mt-2 text-slate-600">Players can request a court spot for a party of 1 to 4 people.</p>

      <p class="mt-6 text-slate-700">
        <a class="text-emerald-700 underline hover:text-emerald-800" href="/signup">Create an account</a>
        or
        <a class="text-emerald-700 underline hover:text-emerald-800" href="/login">log in</a>
        to manage reservations.
      </p>

      <p class="mt-4">
        <a class="text-emerald-700 underline hover:text-emerald-800" href="/courts">View court slots</a>
      </p>
      <p class="mt-2">
        <a class="text-emerald-700 underline hover:text-emerald-800" href="/reservations">Request a reservation</a>
      </p>
      <p class="mt-2">
        <a class="text-emerald-700 underline hover:text-emerald-800" href="/players">View player skill levels</a>
      </p>
    </main>
  </body>
</html>