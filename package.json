{
  "name": "326-court-booking",
  "version": "1.0.0",
  "description": "Court Booking is a pickleball court reservation app for COMPSCI 326.",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "admin:create": "node scripts/provisionAdmin.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=/e2e/",
    "test:e2e": "playwright test",
    "check": "node --check server.js && node --check app.js && node --check public/app.js && node --check scripts/provisionAdmin.js && node --check playwright.config.js && node --check e2e/auth-authorization.spec.js",
    "styles:build": "npx @tailwindcss/cli -i ./src/input.css -o ./public/style.css --minify",
    "styles:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./public/style.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huang-grace05/326-court-booking.git"
  },
  "keywords": [],
  "author": "vizzycode",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/huang-grace05/326-court-booking/issues"
  },
  "homepage": "https://github.com/huang-grace05/326-court-booking#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3"
  }
}
